[Unit]
Description=Saving Grace static Astro site for public staging (loopback only)
After=network.target

[Service]
ExecStart=/usr/bin/python3 -I /srv/savinggrace-static/static-server.py /srv/savinggrace-static/current
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET
CapabilityBoundingSet=
MemoryMax=256M
Restart=on-failure

[Install]
WantedBy=multi-user.target
