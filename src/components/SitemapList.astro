---
import { pages, posts, taxonomyLabels } from "../lib/content";

const sections: Record<string, string> = { about: "About Us", teaching: "What We Teach", ministries: "Ministries", events: "News & Events", resources: "Resources", giving: "Giving", contact: "Contact", blog: "Blog", sermons: "Sermons", home: "Home" };
const groups = new Map<string, { href: string; label: string }[]>();
for (const page of pages) {
  const key = sections[page.section] ?? "More";
  groups.set(key, [...(groups.get(key) ?? []), { href: page.path, label: page.navTitle }]);
}
groups.set("Sermons", [
  ...(groups.get("Sermons") ?? []),
  { href: "/sermons/", label: "All Sermons" },
  ...Object.values(taxonomyLabels).map((t) => ({ href: t.path, label: `Sermons by ${t.singular.toLowerCase()}` })),
]);
groups.set("Blog", posts.map((post) => ({ href: post.path, label: post.title })));
---
<div class="sitemap-groups">
  {[...groups].map(([label, links]) => (
    <section class="sitemap-group">
      <h2 class="page__h2">{label}</h2>
      <ul class="page__list">{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
    </section>
  ))}
</div>
