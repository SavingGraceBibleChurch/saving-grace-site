---
import { pageById } from "../lib/content";

interface Props { ids: string[] }
const items = Astro.props.ids.map((id) => pageById(id)).filter((page) => page !== undefined);
---
{items.length > 0 && (
  <nav class="page__related" aria-labelledby="related-heading">
    <h2 id="related-heading" class="section__title">Also in this section</h2>
    <ul class="related-list" role="list">{items.map((page) => <li><a href={page!.path}>{page!.navTitle}</a></li>)}</ul>
  </nav>
)}
