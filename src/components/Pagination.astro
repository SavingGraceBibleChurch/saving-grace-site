---
interface Props { current: number; total: number; base: string }
const { current, total, base } = Astro.props;
const href = (n: number) => (n === 1 ? base : `${base}page/${n}/`);
const window = [...new Set([1, current - 1, current, current + 1, total])].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
---
{total > 1 && (
  <nav class="pagination" aria-label="Sermon pages">
    {current > 1 && <a class="pagination__step" href={href(current - 1)} rel="prev">← Newer</a>}
    <ol class="pagination__pages" role="list">
      {window.map((n, i) => (
        <>
          {i > 0 && n - window[i - 1]! > 1 && <li class="pagination__gap" aria-hidden="true">…</li>}
          <li>{n === current ? <span aria-current="page">{n}</span> : <a href={href(n)}>{n}</a>}</li>
        </>
      ))}
    </ol>
    {current < total && <a class="pagination__step" href={href(current + 1)} rel="next">Older →</a>}
  </nav>
)}
