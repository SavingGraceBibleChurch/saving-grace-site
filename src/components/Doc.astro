---
// Lays out a page's content blocks. Everything before the first main heading is the
// introduction; each main heading then starts a section. On wide screens a section's
// heading sits in a left column beside its content; on phones they stack.
import type { Block } from "../lib/types";
import Blocks from "./Blocks.astro";

interface Props { blocks: Block[]; aside?: Block[] }
const { blocks, aside = [] } = Astro.props;

type Heading = Extract<Block, { kind: "heading" }>;
const isMain = (block: Block): block is Heading => block.kind === "heading" && block.level === 2;
const first = blocks.findIndex(isMain);
const intro = first === -1 ? blocks : blocks.slice(0, first);
const sections: { heading: Heading; id: string; blocks: Block[] }[] = [];
const used = new Set<string>();
for (const block of first === -1 ? [] : blocks.slice(first)) {
  if (isMain(block)) {
    let id = block.id ?? block.text.toLowerCase().replace(/[^a-z0-9]+/gu, "-").replace(/^-|-$/gu, "").slice(0, 60);
    while (used.has(id) || !id) id = `${id || "section"}-${sections.length + 1}`;
    used.add(id);
    sections.push({ heading: block, id, blocks: [] });
  } else {
    sections[sections.length - 1]!.blocks.push(block);
  }
}
// Introductions with two or more paragraphs read as two columns on wide screens.
const paragraphs = intro.filter((block) => block.kind === "paragraph" && !block.lede).length;
const columns = paragraphs >= 2;
---
<div class="doc">
  {intro.length > 0 && <div class:list={["doc__intro", "prose", { "doc__intro--columns": columns }]}><Blocks blocks={intro} /></div>}
  {sections.length >= 4 && (
    <nav class="doc__toc" aria-label="On this page">
      <p class="doc__toc-label">On this page</p>
      <ul role="list">{sections.map((section) => <li><a href={`#${section.id}`}>{section.heading.text}</a></li>)}</ul>
    </nav>
  )}
  {sections.map((section) => (
    <section class="doc__section" id={section.id} aria-labelledby={`${section.id}-heading`}>
      <header class="doc__aside">
        <h2 class="doc__heading" id={`${section.id}-heading`}>{section.heading.text}</h2>
      </header>
      <div class="doc__content prose"><Blocks blocks={section.blocks} /></div>
    </section>
  ))}
  {aside.length > 0 && <div class="doc__intro doc__after prose"><Blocks blocks={aside} /></div>}
</div>
