---
import type { Sermon } from "../lib/types";
import { term, speakerName } from "../lib/content";
import { bookGroup, groupLabel } from "../lib/books";
import { formatDate } from "../lib/events";

interface Props { sermon: Sermon; headingLevel?: 2 | 3; row?: boolean }
const { sermon, headingLevel = 3, row = false } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const bookSlug = sermon.books.find((slug) => slug !== "selected-text") ?? null;
const book = bookSlug ? term("book", bookSlug) : undefined;
const group = bookGroup(bookSlug);
const series = sermon.series.map((slug) => term("series", slug)).find((t) => t && t.slug !== "topical" && t.name !== book?.name);
// "Mark 14:37-42" -> "14:37-42": the large numerals on the cover.
const numerals = sermon.passage.match(/\d+(?::\d+)?(?:\s*[-–]\s*\d+(?::\d+)?)?\s*$/u)?.[0]?.replace(/\s+/gu, "") ?? "";
---
<li>
  <article class:list={["s-card", `hue--${group}`, { "s-card--row": row }]}>
    <div class="s-card__cover" data-ref={numerals} aria-hidden="true">
      <span class="s-card__group">{groupLabel(group)}</span>
      <span class="s-card__book">{book?.name ?? "Topical"}</span>
    </div>
    <div class="s-card__body">
      <p class="s-card__date"><time datetime={sermon.date}>{formatDate(sermon.date)}</time></p>
      <Heading class="s-card__title"><a href={sermon.path}>{sermon.title}</a></Heading>
      <p class="s-card__meta dots">
        <span>{speakerName(sermon)}</span>
        {sermon.passage && <span>{sermon.passage}</span>}
        {series && <span>{series.name}</span>}
      </p>
    </div>
  </article>
</li>
