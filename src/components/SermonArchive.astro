---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHead from "./PageHead.astro";
import SermonCard from "./SermonCard.astro";
import SermonFeature from "./SermonFeature.astro";
import Pagination from "./Pagination.astro";
import { sermons, termsOf, taxonomyLabels, ARCHIVE_PAGE_SIZE, chunk, SITE } from "../lib/content";

interface Props { page: number }
const { page } = Astro.props;
const pages = chunk(sermons, ARCHIVE_PAGE_SIZE);
const items = pages[page - 1] ?? [];
const base = "/sermons/";
const path = page === 1 ? base : `${base}page/${page}/`;
const title = page === 1
  ? "Sermons - Saving Grace Bible Church - Bible-Based Worship in Melbourne"
  : `Sermons - Saving Grace Bible Church - Bible-Based Worship in Melbourne - Page ${page}`;
const speakers = termsOf("speaker").sort((a, b) => b.count - a.count);
const books = termsOf("book").filter((b) => b.slug !== "selected-text").sort((a, b) => b.count - a.count);
const series = termsOf("series").sort((a, b) => b.count - a.count).slice(0, 10);
const [latest, ...rest] = items;
const grid = page === 1 ? rest : items;
const first = (page - 1) * ARCHIVE_PAGE_SIZE + 1;
---
<BaseLayout
  title={title}
  description={page === 1 ? "Watch and listen to Christ-centred, expository sermons preached at Saving Grace Bible Church in Westmeadows, Melbourne. Browse by speaker, series, Bible book or topic." : ""}
  canonical={path}
  indexable={page === 1}
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Sermons", path: "/sermons/" }]}
  jsonLd={page === 1 ? [{ "@context": "https://schema.org", "@type": "CollectionPage", "@id": `${SITE}/sermons/#webpage`, url: `${SITE}/sermons/`, name: "Sermons", inLanguage: "en-AU", isPartOf: { "@id": `${SITE}/#website` } }] : []}
>
  <article class="page page--sermons">
    <PageHead title={page === 1 ? "Sermons" : `Sermons — page ${page}`} trail={[{ label: "Home", href: "/" }]} eyebrow={`${sermons.length} sermons since ${sermons.at(-1)?.date.slice(0, 4)}`}>
      <form class="search-field" method="get" action="/search/" role="search" aria-label="Search sermons" id="sermon-search">
        <label class="sr-only" for="sermon-search-input">Search sermons</label>
        <input id="sermon-search-input" type="search" name="q" placeholder="Search titles, passages and topics" maxlength="120" />
        <button class="button" type="submit">Search</button>
      </form>
    </PageHead>
    <div class="page__body">
      {page === 1 && (
        <nav class="browse" aria-label="Browse sermons">
          <div class="browse__row"><p class="browse__label"><a href={taxonomyLabels.speaker.path}>Speakers</a></p><ul class="browse__chips" role="list">{speakers.map((t) => <li><a class="chip" href={t.path}>{t.name}<span class="chip__count">{t.count}</span></a></li>)}</ul></div>
          <div class="browse__row"><p class="browse__label"><a href={taxonomyLabels.book.path}>Bible books</a></p><ul class="browse__chips" role="list">{books.map((t) => <li><a class="chip" href={t.path}>{t.name}<span class="chip__count">{t.count}</span></a></li>)}</ul></div>
          <div class="browse__row"><p class="browse__label"><a href={taxonomyLabels.series.path}>Series</a></p><ul class="browse__chips" role="list">{series.map((t) => <li><a class="chip" href={t.path}>{t.name}</a></li>)}<li><a class="chip" href={taxonomyLabels.series.path}>All series →</a></li><li><a class="chip" href={taxonomyLabels.topic.path}>Browse {termsOf("topic").length} topics →</a></li></ul></div>
        </nav>
      )}
      <section class="archive__results" aria-labelledby="results-heading" id="results">
        <header class="section-head"><h2 id="results-heading">{page === 1 ? "Latest sermons" : `Sermons ${first}–${first + items.length - 1}`}</h2></header>
        {page === 1 && latest && <div class="archive__feature"><SermonFeature sermon={latest} /></div>}
        <ul class="cards" role="list">{grid.map((sermon) => <SermonCard sermon={sermon} />)}</ul>
        <Pagination current={page} total={pages.length} base={base} />
      </section>
    </div>
  </article>
</BaseLayout>
