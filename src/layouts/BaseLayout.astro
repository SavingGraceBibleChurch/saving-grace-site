---
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource-variable/instrument-sans/index.css";
import "../styles/base.css";
import "../styles/chrome.css";
import "../styles/home.css";
import "../styles/pages.css";
import "../styles/sermons.css";
import "../styles/journal.css";
import "../styles/listing.css";
import "../styles/studies.css";
import "../styles/search.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, SITE_NAME } from "../lib/content";

export interface Crumb { name: string; path: string }

interface Props {
  title: string;
  description?: string;
  /** Root-relative canonical path; defaults to the current path. */
  canonical?: string;
  indexable?: boolean;
  ogType?: string | null;
  ogTitle?: string | null;
  ogDescription?: string | null;
  /** Absolute or root-relative image for social previews. */
  ogImage?: string | null;
  breadcrumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  currentPath?: string;
  /**
   * How site search sees this page: its type ("Sermon", "Study" or "Page"; null leaves the page out of
   * search, as for lists and the home page) and plain details shown with the result instead of a snippet.
   */
  search?: { type: "Sermon" | "Study" | "Page" | null; label?: string; meta?: Record<string, string | null | undefined> };
}

const {
  title,
  description = "",
  canonical = Astro.url.pathname,
  indexable = true,
  ogType = "website",
  ogTitle,
  ogDescription,
  ogImage = "/brand/saving-grace-logo.png",
  breadcrumbs = [],
  jsonLd = [],
  currentPath = Astro.url.pathname,
  search = { type: "Page" },
} = Astro.props;

// Search details travel as data attributes, so commas and quotes in a summary cannot break them.
const searchMeta = Object.entries({ label: search.label ?? (search.type === "Study" ? "Tuesday Night Study" : search.type), summary: description, ...search.meta })
  .filter((entry): entry is [string, string] => Boolean(entry[1]));
const searchAttributes: Record<string, string> = search.type
  ? {
      "data-pagefind-body": "",
      "data-pagefind-filter": `type:${search.type}`,
      ...(searchMeta.length ? { "data-pagefind-meta": searchMeta.map(([key]) => `${key}[data-search-${key}]`).join(", ") } : {}),
      ...Object.fromEntries(searchMeta.map(([key, value]) => [`data-search-${key}`, value])),
    }
  : {};

const absolute = (path: string) => (path.startsWith("http") ? path : `${SITE}${path}`);
const canonicalUrl = absolute(canonical);
const image = ogImage ? absolute(ogImage) : null;
const graph: Record<string, unknown>[] = [...jsonLd];
if (breadcrumbs.length > 1) {
  graph.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: absolute(crumb.path),
    })),
  });
}
const robots = indexable ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" : "noindex, follow";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robots} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0e2a38" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/icon-192.png" sizes="192x192" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} » Sermons`} href="/sermons/feed/" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType ?? "website"} />
    <meta property="og:title" content={ogTitle ?? title} />
    {(ogDescription ?? description) && <meta property="og:description" content={ogDescription ?? description} />}
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    {(ogDescription ?? description) && <meta name="twitter:description" content={ogDescription ?? description} />}
    {image && <meta name="twitter:image" content={image} />}
    {graph.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(graph.length === 1 ? graph[0] : graph)} />}
    <slot name="head" />
  </head>
  {/* "Back to top" (in the footer) links to #top. It must be the page itself: the header sticks to the top of the
      screen, so linking to the header would leave the browser nothing to scroll to. */}
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header currentPath={currentPath} />
    <main id="main-content" {...searchAttributes}>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        var items = document.querySelectorAll("[data-reveal]");
        if (!("IntersectionObserver" in window)) { items.forEach(function (el) { el.classList.add("is-visible"); }); return; }
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) { entry.target.classList.add("is-visible"); observer.unobserve(entry.target); }
          });
        }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
        items.forEach(function (el) { observer.observe(el); });
      })();
      // Sermon rows: "See more" opens a description; "Show all" reveals the rest of a long list.
      document.addEventListener("click", function (event) {
        var toggle = event.target.closest(".journal__toggle");
        if (toggle) {
          var description = document.getElementById(toggle.getAttribute("aria-controls"));
          if (!description) return;
          var open = toggle.getAttribute("aria-expanded") !== "true";
          toggle.setAttribute("aria-expanded", String(open));
          description.classList.toggle("is-open", open);
          var label = toggle.querySelector("[data-description-label]");
          if (label) label.textContent = open ? "See less" : "See more";
          return;
        }
        var show = event.target.closest("[data-journal-show]");
        if (show) {
          var box = show.closest("[data-journal-more]");
          box.classList.add("is-open");
          var first = box.querySelector(".journal--rest .journal__title a");
          if (first) first.focus({ preventScroll: true });
        }
      });
    </script>
  </body>
</html>
