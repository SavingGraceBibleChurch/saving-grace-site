---
import "../styles/tokens.css";
import "../styles/core.css";
import "../styles/church.css";
import "../styles/home.css";
import "../styles/cards.css";
import "../styles/sermon.css";
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, SITE_NAME } from "../lib/content";

export interface Crumb { name: string; path: string }

interface Props {
  title: string;
  description?: string;
  /** Root-relative canonical path; defaults to the current path. */
  canonical?: string;
  indexable?: boolean;
  ogType?: string | null;
  ogTitle?: string | null;
  ogDescription?: string | null;
  /** Absolute or root-relative image for social previews. */
  ogImage?: string | null;
  breadcrumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  currentPath?: string;
  search?: boolean;
}

const {
  title,
  description = "",
  canonical = Astro.url.pathname,
  indexable = true,
  ogType = "website",
  ogTitle,
  ogDescription,
  ogImage = "/brand/saving-grace-logo.png",
  breadcrumbs = [],
  jsonLd = [],
  currentPath = Astro.url.pathname,
  search = true,
} = Astro.props;

const absolute = (path: string) => (path.startsWith("http") ? path : `${SITE}${path}`);
const canonicalUrl = absolute(canonical);
const image = ogImage ? absolute(ogImage) : null;
const graph: Record<string, unknown>[] = [...jsonLd];
if (breadcrumbs.length > 1) {
  graph.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: absolute(crumb.path),
    })),
  });
}
const robots = indexable ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" : "noindex, follow";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robots} />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href="/brand/fonts/bitstream-vera-sans-regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/brand/fonts/bitstream-vera-sans-bold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/icon-192.png" sizes="192x192" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} » Sermons`} href="/sermons/feed/" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType ?? "website"} />
    <meta property="og:title" content={ogTitle ?? title} />
    {(ogDescription ?? description) && <meta property="og:description" content={ogDescription ?? description} />}
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    {(ogDescription ?? description) && <meta name="twitter:description" content={ogDescription ?? description} />}
    {image && <meta name="twitter:image" content={image} />}
    {graph.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(graph.length === 1 ? graph[0] : graph)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header currentPath={currentPath} search={search} />
    <main id="main-content" class="site-main" data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>
