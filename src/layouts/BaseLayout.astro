---
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource-variable/instrument-sans/index.css";
import "../styles/base.css";
import "../styles/chrome.css";
import "../styles/home.css";
import "../styles/pages.css";
import "../styles/sermons.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, SITE_NAME } from "../lib/content";

export interface Crumb { name: string; path: string }

interface Props {
  title: string;
  description?: string;
  /** Root-relative canonical path; defaults to the current path. */
  canonical?: string;
  indexable?: boolean;
  ogType?: string | null;
  ogTitle?: string | null;
  ogDescription?: string | null;
  /** Absolute or root-relative image for social previews. */
  ogImage?: string | null;
  breadcrumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  currentPath?: string;
}

const {
  title,
  description = "",
  canonical = Astro.url.pathname,
  indexable = true,
  ogType = "website",
  ogTitle,
  ogDescription,
  ogImage = "/brand/saving-grace-logo.png",
  breadcrumbs = [],
  jsonLd = [],
  currentPath = Astro.url.pathname,
} = Astro.props;

const absolute = (path: string) => (path.startsWith("http") ? path : `${SITE}${path}`);
const canonicalUrl = absolute(canonical);
const image = ogImage ? absolute(ogImage) : null;
const graph: Record<string, unknown>[] = [...jsonLd];
if (breadcrumbs.length > 1) {
  graph.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: absolute(crumb.path),
    })),
  });
}
const robots = indexable ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" : "noindex, follow";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robots} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0e2a38" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/icon-192.png" sizes="192x192" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} » Sermons`} href="/sermons/feed/" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType ?? "website"} />
    <meta property="og:title" content={ogTitle ?? title} />
    {(ogDescription ?? description) && <meta property="og:description" content={ogDescription ?? description} />}
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    {(ogDescription ?? description) && <meta name="twitter:description" content={ogDescription ?? description} />}
    {image && <meta name="twitter:image" content={image} />}
    {graph.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(graph.length === 1 ? graph[0] : graph)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header currentPath={currentPath} />
    <main id="main-content" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        var items = document.querySelectorAll("[data-reveal]");
        if (!("IntersectionObserver" in window)) { items.forEach(function (el) { el.classList.add("is-visible"); }); return; }
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) { entry.target.classList.add("is-visible"); observer.unobserve(entry.target); }
          });
        }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
        items.forEach(function (el) { observer.observe(el); });
      })();
    </script>
  </body>
</html>
