---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHead from "../components/PageHead.astro";
import SearchPanel from "../components/SearchPanel.astro";
---
<BaseLayout
  search={{ type: null }} title="Search - Saving Grace Bible Church - Bible-Based Worship in Melbourne" description="Search sermons, Tuesday Night Studies and pages on the Saving Grace Bible Church website." canonical="/search/" indexable={false}>
  <article class="page page--search">
    <PageHead title="Search" trail={[{ label: "Home", href: "/" }]} lede="Search every sermon, Tuesday night study and page. Type a word, a speaker's name or a Bible reference such as John 3:16." />
    <div class="page__body">
      <SearchPanel id="site-search" label="Search the website" placeholder="A word, a name, a passage" scopes syncUrl />
      <noscript><p>Search needs JavaScript. You can still <a href="/sermons/">browse all sermons</a>, <a href="/studies/">the Tuesday Night Studies</a> or <a href="/pages/sitemap/">every page</a>.</p></noscript>
    </div>
  </article>
</BaseLayout>
