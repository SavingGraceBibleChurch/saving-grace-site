---
import BaseLayout from "../layouts/BaseLayout.astro";
import SermonCard from "../components/SermonCard.astro";
import EventRow from "../components/EventRow.astro";
import Picture from "../components/Picture.astro";
import { home, sermons, SITE, SITE_NAME } from "../lib/content";
import { upcoming, melbourneToday } from "../lib/events";
import { contact } from "../lib/site";

const { seo, copy } = home;
const hero = copy.heroCopy;
const services = copy.servicesCopy;
const about = copy.aboutCopy;
const soon = upcoming(melbourneToday(), 21, 4);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Church",
    "@id": `${SITE}/#church`,
    name: SITE_NAME,
    url: `${SITE}/`,
    logo: `${SITE}/brand/saving-grace-logo.png`,
    image: `${SITE}/media/congregation.jpg`,
    telephone: "+61450545589",
    email: contact.email,
    address: {
      "@type": "PostalAddress",
      streetAddress: contact.streetAddress,
      addressLocality: contact.addressLocality,
      addressRegion: contact.addressRegion,
      postalCode: contact.postalCode,
      addressCountry: "AU",
    },
    sameAs: [
      "https://www.facebook.com/Saving-Grace-Bible-Church-Preston-139937276610219/",
      "https://www.youtube.com/channel/UCzknLApowBjwBzTRBfUE_WA",
      "https://www.instagram.com/savinggracebiblechurch/",
      "https://www.sermonaudio.com/solo/savinggrace/",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE}/#website`,
    url: `${SITE}/`,
    name: SITE_NAME,
    inLanguage: "en-AU",
    potentialAction: { "@type": "SearchAction", target: `${SITE}/search/?q={search_term_string}`, "query-input": "required name=search_term_string" },
  },
];
---
<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical="/"
  ogType={seo.ogType ?? "website"}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  ogImage="/media/congregation.jpg"
  jsonLd={jsonLd}
>
  <div class="home">
    <section class="arrive" aria-labelledby="hero-heading">
      <div class="arrive__inner">
        <div class="arrive__welcome">
          <h1 id="hero-heading" class="arrive__title"><span class="arrive__eyebrow">{hero.eyebrow}</span> <span class="arrive__name">{hero.nameLine1}</span> <span class="arrive__name">{hero.nameLine2}</span></h1>
          <p class="arrive__place">Westmeadows, Melbourne</p>
        </div>
        <div class="welcome-card" id="visit">
          <div class="welcome-card__body">
            <p class="welcome-card__time">{hero.serviceTime}</p>
            <p class="welcome-card__where">{hero.address}</p>
            <a class="button welcome-card__cta" href={hero.joinHref}>{hero.join}</a>
            <a class="welcome-card__more" href={hero.joinHref}>{hero.newHere} What to expect</a>
          </div>
        </div>
      </div>
      <figure class="arrive__photograph"><Picture id="congregation" class="arrive__image" eager /></figure>
      <div class="arrive__inner arrive__inner--services" id="services">
        <section aria-labelledby="services-heading">
          <div class="section__head"><h2 id="services-heading" class="section__title">{services.heading}</h2></div>
          <ul class="services" role="list">
            <li class="service service--morning"><h3 class="service__title"><a href={services.morning.href}>{services.morning.title}</a></h3><p class="service__text">{services.morning.text}</p></li>
            <li class="service service--evening"><h3 class="service__title"><a href={services.evening.href}>{services.evening.title}</a></h3><p class="service__text">{services.evening.text}</p></li>
          </ul>
        </section>
      </div>
    </section>

    <section class="section welcome" id="welcome" aria-labelledby="welcome-heading">
      <div class="welcome__spread">
        <h2 id="welcome-heading" class="welcome__title">{copy.welcomeCopy.heading}</h2>
        <p class="welcome__lede lede">{copy.welcomeCopy.paragraph}</p>
      </div>
      <ul class="pillars" role="list">
        {copy.pillars.map((pillar: any) => (
          <li class="pillar">
            <div class="pillar__body">
              <h3 class="pillar__title" id={`pillar-${pillar.id}`}>{pillar.title}</h3>
              <p class="pillar__text">{pillar.text}</p>
              <a class="pillar__more" href={pillar.href}>{pillar.readMore}<span class="sr-only"> about {pillar.title}</span></a>
            </div>
          </li>
        ))}
      </ul>
      <figure class="home__photo"><Picture id="welcome-door" class="home__photo-image" /></figure>
    </section>

    <section class="section" id="sermons" aria-labelledby="recent-heading">
      <div class="section__head"><h2 id="recent-heading" class="section__title">{copy.sermonsCopy.heading}</h2><div class="section__aside"><a class="button button--outline" href="/sermons/">{copy.sermonsCopy.viewAll}</a></div></div>
      <ul class="cards" role="list">{sermons.slice(0, 3).map((sermon, index) => <SermonCard sermon={sermon} latest={index === 0} />)}</ul>
    </section>

    <section class="section about-row" aria-labelledby="about-heading">
      <div class="about" id="about">
        <h2 id="about-heading" class="about__title">{about.heading}</h2>
        <p class="about__text prose">{about.paragraph}</p>
        <p class="about__more"><a class="pillar__more" href={about.learnMoreHref}>{about.learnMore}</a></p>
      </div>
      <section class="offering" id="give" aria-labelledby="give-heading">
        <h2 id="give-heading" class="offering__title">{about.giveHeading}</h2>
        <blockquote class="offering__quote"><p>{about.quote}</p><footer class="offering__cite">{about.attribution}</footer></blockquote>
        <p class="offering__link"><a class="button button--onink" href={about.giveHref}>{about.giveLink}</a></p>
      </section>
    </section>

    {soon.length > 0 && (
      <section class="section" id="events" aria-labelledby="events-heading">
        <div class="section__head"><h2 id="events-heading" class="section__title">{copy.eventsCopy.heading}</h2><div class="section__aside"><a class="button button--outline events__calendar" href="/events/">{copy.eventsCopy.viewCalendar}</a></div></div>
        <ol class="events" role="list">{soon.map((occurrence) => <EventRow occurrence={occurrence} />)}</ol>
      </section>
    )}
  </div>
</BaseLayout>
