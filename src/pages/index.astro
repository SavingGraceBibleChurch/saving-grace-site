---
import BaseLayout from "../layouts/BaseLayout.astro";
import SermonCard from "../components/SermonCard.astro";
import SermonFeature from "../components/SermonFeature.astro";
import EventRow from "../components/EventRow.astro";
import Picture from "../components/Picture.astro";
import { home, sermons, SITE, SITE_NAME } from "../lib/content";
import { upcoming, melbourneToday } from "../lib/events";
import { contact } from "../lib/site";

const { seo, copy } = home;
const hero = copy.heroCopy;
const services = copy.servicesCopy;
const about = copy.aboutCopy;
const soon = upcoming(melbourneToday(), 21, 4);
const [latest, ...recent] = sermons.slice(0, 3);
// "Sunday Morning 10:30am (Formal)" -> big numerals "10:30" and "am".
const clock = (title: string) => title.match(/(\d{1,2}:\d{2})\s*(am|pm)/iu);
const serviceList = [services.morning, services.evening].map((service: { title: string; text: string; href: string }) => ({ ...service, clock: clock(service.title) }));

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Church",
    "@id": `${SITE}/#church`,
    name: SITE_NAME,
    url: `${SITE}/`,
    logo: `${SITE}/brand/saving-grace-logo.png`,
    image: `${SITE}/media/congregation.jpg`,
    telephone: "+61450545589",
    email: contact.email,
    address: {
      "@type": "PostalAddress",
      streetAddress: contact.streetAddress,
      addressLocality: contact.addressLocality,
      addressRegion: contact.addressRegion,
      postalCode: contact.postalCode,
      addressCountry: "AU",
    },
    sameAs: [
      "https://www.facebook.com/Saving-Grace-Bible-Church-Preston-139937276610219/",
      "https://www.youtube.com/channel/UCzknLApowBjwBzTRBfUE_WA",
      "https://www.instagram.com/savinggracebiblechurch/",
      "https://www.sermonaudio.com/solo/savinggrace/",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE}/#website`,
    url: `${SITE}/`,
    name: SITE_NAME,
    inLanguage: "en-AU",
    potentialAction: { "@type": "SearchAction", target: `${SITE}/search/?q={search_term_string}`, "query-input": "required name=search_term_string" },
  },
];
---
<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical="/"
  ogType={seo.ogType ?? "website"}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  ogImage="/media/congregation.jpg"
  jsonLd={jsonLd}
>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="eyebrow">Westmeadows, Melbourne</p>
        <h1 id="hero-heading" class="hero__title"><span class="hero__kicker">{hero.eyebrow}</span> <span>{hero.nameLine1}</span> <span>{hero.nameLine2}</span></h1>
        <p class="hero__lede">{seo.description}</p>
        <div class="hero__actions">
          <a class="button button--lg" href={hero.joinHref}>{hero.join}</a>
          <a class="link-arrow" href={hero.joinHref}>{hero.newHere} What to expect</a>
        </div>
        <dl class="hero__facts">
          <div><dt>Lord's Day</dt><dd>{hero.serviceTime}</dd></div>
          <div><dt>Find us</dt><dd>{hero.address}</dd></div>
        </dl>
      </div>
      <figure class="hero__art">
        <div class="arch"><Picture id="congregation" eager /></div>
        <a class="hero__card" href={hero.joinHref}>
          <span class="hero__card-label">This Lord's Day</span>
          <span class="hero__card-time">{hero.serviceTime}</span>
          <span class="hero__card-note">Morning Worship</span>
        </a>
      </figure>
    </div>
  </section>

  <section class="services band--navy" id="services" aria-labelledby="services-heading">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <div><p class="eyebrow">Every Sunday</p><h2 id="services-heading">{services.heading}</h2></div>
      </header>
      <ul class="services__grid" role="list">
        {serviceList.map((service, index) => (
          <li class="service" data-reveal style={`--reveal-delay:${index * 0.12}s`}>
            {service.clock && <p class="service__time" aria-hidden="true">{service.clock[1]}<small>{service.clock[2]!.toLowerCase()}</small></p>}
            <h3 class="service__title"><a href={service.href}>{service.title}</a></h3>
            <p class="service__text">{service.text}</p>
            <span class="link-arrow" aria-hidden="true">Learn more</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="welcome" aria-labelledby="welcome-heading">
    <div class="wrap welcome__grid">
      <figure class="welcome__art" data-reveal><div class="arch"><Picture id="welcome-door" /></div></figure>
      <div>
        <div data-reveal>
          <p class="eyebrow">Our church</p>
          <h2 id="welcome-heading" class="welcome__title">{copy.welcomeCopy.heading}</h2>
          <p class="welcome__lede">{copy.welcomeCopy.paragraph}</p>
        </div>
        <ul class="pillars" role="list">
          {copy.pillars.map((pillar: { id: string; title: string; text: string; href: string; readMore: string }, index: number) => (
            <li class="pillar" data-reveal style={`--reveal-delay:${(index % 2) * 0.1}s`}>
              <h3 class="pillar__title" id={`pillar-${pillar.id}`}>{pillar.title}</h3>
              <p class="pillar__text">{pillar.text}</p>
              <a class="link-arrow" href={pillar.href}>{pillar.readMore}<span class="sr-only"> about {pillar.title}</span></a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tint" id="sermons" aria-labelledby="recent-heading">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <div><p class="eyebrow">Preaching</p><h2 id="recent-heading">{copy.sermonsCopy.heading}</h2></div>
        <a class="button button--outline" href="/sermons/">{copy.sermonsCopy.viewAll}</a>
      </header>
      <div class="showcase" data-reveal>
        {latest && <SermonFeature sermon={latest} />}
        <ul class="showcase__side" role="list">{recent.map((sermon) => <SermonCard sermon={sermon} row />)}</ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="about-heading">
    <div class="wrap about-give">
      <div class="about" id="about" data-reveal>
        <p class="eyebrow">Who we are</p>
        <h2 id="about-heading" class="about__title">{about.heading}</h2>
        <p class="about__text">{about.paragraph}</p>
        <a class="link-arrow" href={about.learnMoreHref}>{about.learnMore.replace(/\s*>\s*$/u, "")}</a>
      </div>
      <section class="give-card" id="give" aria-labelledby="give-heading" data-reveal style="--reveal-delay:.12s">
        <div>
          <h2 id="give-heading" class="eyebrow">{about.giveHeading}</h2>
          <blockquote><p>{about.quote}</p><footer>{about.attribution.replace(/^[—–-]\s*/u, "")}</footer></blockquote>
        </div>
        <p><a class="button button--onink" href={about.giveHref}>{about.giveLink}</a></p>
      </section>
    </div>
  </section>

  {soon.length > 0 && (
    <section class="section section--tint" id="events" aria-labelledby="events-heading">
      <div class="wrap">
        <header class="section-head" data-reveal>
          <div><p class="eyebrow">Coming up</p><h2 id="events-heading">{copy.eventsCopy.heading}</h2></div>
          <a class="button button--outline" href="/events/">{copy.eventsCopy.viewCalendar}</a>
        </header>
        <ol class="events" role="list" data-reveal>{soon.map((occurrence) => <EventRow occurrence={occurrence} />)}</ol>
      </div>
    </section>
  )}
</BaseLayout>
