---
import BaseLayout from "../../layouts/BaseLayout.astro";
import JournalList from "../../components/JournalList.astro";
import Video from "../../components/Video.astro";
import { sermons, term, speakerName, sermonSummary, youtubeThumbnail, SITE, SITE_NAME } from "../../lib/content";
import { bookGroup } from "../../lib/books";
import { formatDate } from "../../lib/events";
import { extraFor, formatDuration, paragraphs, excerpt } from "../../lib/extras";
import { transcriptFor } from "../../lib/transcripts";
import type { Sermon } from "../../lib/types";

export function getStaticPaths() {
  return sermons.map((sermon) => ({ params: { slug: sermon.slug }, props: { sermon } }));
}

const { sermon } = Astro.props as { sermon: Sermon };
const speakers = sermon.speakers.map((slug) => term("speaker", slug)).filter((t) => t !== undefined);
const series = sermon.series.map((slug) => term("series", slug)).filter((t) => t !== undefined);
const books = sermon.books.map((slug) => term("book", slug)).filter((t) => t !== undefined);
const mainBook = sermon.books.find((slug) => slug !== "selected-text");
const extra = extraFor(sermon);
const duration = formatDuration(extra?.durationSeconds);
const about = extra?.summary ? paragraphs(extra.summary) : [];
const transcript = transcriptFor(sermon);
const description = sermon.seo.description ||(extra?.summary ? excerpt(extra.summary) : sermonSummary(sermon));

// Related: the rest of the same series first, then the same book, newest first.
const related: Sermon[] = [];
const add = (list: Sermon[]) => {
  for (const s of list) if (s.slug !== sermon.slug && !related.includes(s) && related.length < 3) related.push(s);
};
add(sermons.filter((s) => s.series.some((x) => sermon.series.includes(x) && x !== "topical")));
if (mainBook) add(sermons.filter((s) => s.books.includes(mainBook)));
add(sermons.filter((s) => s.speakers.some((x) => sermon.speakers.includes(x))));

const index = sermons.indexOf(sermon);
const newer = sermons[index - 1];
const older = sermons[index + 1];

const jsonLd: Record<string, unknown>[] = [];
if (sermon.youtubeId) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "VideoObject",
    name: sermon.title,
    description,
    thumbnailUrl: [youtubeThumbnail(sermon.youtubeId)],
    uploadDate: `${sermon.date}T10:30:00+10:00`,
    embedUrl: `https://www.youtube.com/embed/${sermon.youtubeId}`,
    contentUrl: `https://www.youtube.com/watch?v=${sermon.youtubeId}`,
    inLanguage: "en-AU",
    publisher: { "@type": "Organization", name: SITE_NAME, logo: { "@type": "ImageObject", url: `${SITE}/brand/saving-grace-logo.png` } },
  });
}
---
<BaseLayout
  title={sermon.seo.title}
  description={description}
  canonical={sermon.seo.canonical ?? sermon.path}
  indexable={sermon.seo.indexable}
  ogType="article"
  ogTitle={sermon.seo.ogTitle}
  ogImage={sermon.youtubeId ? youtubeThumbnail(sermon.youtubeId) : undefined}
  breadcrumbs={[{ name: "Home", path: "/" }, { name: sermon.title, path: sermon.path }]}
  jsonLd={jsonLd}
>
  <article class={`sermon hue--${bookGroup(mainBook)}`} data-pagefind-meta={`date:${sermon.date}`}>
    <div class="wrap">
      <header class="sermon__head">
        <nav aria-label="Breadcrumb"><ol class="trail" role="list"><li><a href="/">Home</a></li><li><a href="/sermons/">Sermons</a></li>{books[0] && <li><a href={books[0].path}>{books[0].name}</a></li>}</ol></nav>
        {sermon.passage && <p class="sermon__passage">{sermon.passage}</p>}
        <h1 class:list={["sermon__title", { "is-long": sermon.title.length > 44 }]}>{sermon.seo.h1 ?? sermon.title}</h1>
        <p class="sermon__meta dots">
          <time datetime={sermon.date}>{formatDate(sermon.date)}</time>
          {speakers.map((s) => <a href={s!.path}>{s!.name}</a>)}
          {series.map((s) => <a href={s!.path}>{s!.name}</a>)}
        </p>
      </header>

      <div class="sermon__layout">
        <div class="sermon__main">
          <section id="watch" aria-labelledby="watch-heading">
            <h2 id="watch-heading" class="sr-only">Watch or listen</h2>
            {sermon.youtubeId && <Video youtubeId={sermon.youtubeId} title={`${sermon.title} — ${speakerName(sermon)}`} label="Watch the sermon" priority />}
            {sermon.sermonAudioId && (
              <div class="audio" id="listen">
                <iframe src={`https://embed.sermonaudio.com/player/a/${sermon.sermonAudioId}/?mini=true`} title={`Listen to ${sermon.title} on SermonAudio`} loading="lazy" height="60"></iframe>
              </div>
            )}
            <p class="media-links">
              {sermon.youtubeId && <a class="link-arrow" href={`https://www.youtube.com/watch?v=${sermon.youtubeId}`} rel="noopener">Watch on YouTube<span class="sr-only"> (external site)</span></a>}
              {sermon.sermonAudioId && <a class="link-arrow" href={`https://www.sermonaudio.com/sermons/${sermon.sermonAudioId}`} rel="noopener">Listen on SermonAudio<span class="sr-only"> (external site)</span></a>}
            </p>
          </section>
          {about.length > 0 && (
            <section class="sermon__about" id="about" aria-labelledby="about-heading">
              <h2 id="about-heading">About this sermon</h2>
              {about.map((text) => <p>{text}</p>)}
            </section>
          )}
          {transcript && (
            <section class="sermon__transcript" aria-labelledby="transcript-heading" data-pagefind-ignore>
              <h2 id="transcript-heading" class="sr-only">Transcript</h2>
              <details class="studies__transcript" id="transcript">
                <summary><span><span class="studies__disclosure" aria-hidden="true">+</span>Complete transcript</span><span class="studies__transcript-length">{transcript.words.toLocaleString("en-AU")} words</span></summary>
                <div class="studies__transcript-body">
                  <p class="sermon__transcript-note">{transcript.source === "sermonaudio" ? "Machine transcript from SermonAudio." : "Machine transcript from the video captions."} It has not been checked against the recording and may contain errors.</p>
                  {paragraphs(transcript.text).map((text) => <p>{text}</p>)}
                </div>
              </details>
            </section>
          )}
        </div>

        <aside class="details-card" aria-label="Sermon details">
          <dl>
            <div><dt>Preached</dt><dd>{formatDate(sermon.date)}</dd></div>
            {speakers.length > 0 && <div><dt>Speaker</dt><dd>{speakers.map((s, i) => <>{i > 0 && ", "}<a href={s!.path}>{s!.name}</a></>)}</dd></div>}
            {series.length > 0 && <div><dt>Series</dt><dd>{series.map((s, i) => <>{i > 0 && ", "}<a href={s!.path}>{s!.name}</a></>)}</dd></div>}
            {sermon.passage && <div><dt>Passage</dt><dd>{sermon.passage}</dd></div>}
            {books.length > 0 && <div><dt>Bible book</dt><dd>{books.map((b, i) => <>{i > 0 && ", "}<a href={b!.path}>{b!.name}</a></>)}</dd></div>}
            {duration && <div><dt>Recording length</dt><dd>{duration}</dd></div>}
          </dl>
        </aside>
      </div>

      {related.length > 0 && (
        <section class="sermon__section" id="related" aria-labelledby="related-heading">
          <h2 id="related-heading">Related sermons</h2>
          <JournalList sermons={related} />
        </section>
      )}

      <nav class="sermon-step" aria-label="More sermons">
        {newer && <a class="sermon-step__link" href={newer.path} rel="prev"><span class="sermon-step__label">← Newer sermon</span>{newer.title}</a>}
        {older && <a class="sermon-step__link sermon-step__link--older" href={older.path} rel="next"><span class="sermon-step__label">Older sermon →</span>{older.title}</a>}
      </nav>
    </div>
  </article>
</BaseLayout>
