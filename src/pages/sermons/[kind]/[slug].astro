---
// One speaker, series, Bible book or passage, with its sermons in sections.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHead from "../../../components/PageHead.astro";
import JournalList from "../../../components/JournalList.astro";
import { taxonomyTerms, taxonomyLabels, sermonsFor, term, sermons, imageFor, SITE, SITE_NAME } from "../../../lib/content";
import { byBook, byYear, inPassageOrder, oldestFirst, seriesInfo, years } from "../../../lib/groups";
import { bookGroup } from "../../../lib/books";
import type { Sermon, TaxonomyTerm } from "../../../lib/types";

export function getStaticPaths() {
  return taxonomyTerms.map((t) => ({ params: { kind: t.kind, slug: t.slug }, props: { t } }));
}
const { t } = Astro.props as { t: TaxonomyTerm };
const label = taxonomyLabels[t.kind];
const list = sermonsFor(t.kind, t.slug);
const count = (n: number) => `${n} sermon${n === 1 ? "" : "s"}`;
const intro = {
  speaker: `${count(list.length)} preached by ${t.name} at Saving Grace Bible Church.`,
  series: `${count(list.length)} in the ${t.name} series.`,
  book: `${count(list.length)} preached from ${t.name}.`,
  passage: `${count(list.length)} on ${t.name}.`,
}[t.kind];

interface Section { id: string; title: string; group: string; note: string; sermons: Sermon[]; more?: { href: string; label: string } }
let sections: Section[] = [];
if (t.kind === "speaker") {
  sections = byBook(list).map((s) => ({ id: s.id, title: s.title, group: s.group, note: `${count(s.sermons.length)} · ${years(s.sermons)}`, sermons: s.sermons, more: s.book ? { href: s.book.path, label: `All sermons from ${s.book.name}` } : undefined }));
} else if (t.kind === "series") {
  const info = seriesInfo(t);
  if (info.bookStudy) {
    sections = [{ id: "sermons", title: "In preaching order", group: info.group, note: `${count(list.length)} · ${info.years}`, sermons: oldestFirst(list) }];
  } else {
    sections = byYear(list).map((y) => ({ id: `y${y.year}`, title: y.year, group: "topical", note: count(y.sermons.length), sermons: y.sermons }));
  }
} else if (t.kind === "book") {
  sections = [{ id: "sermons", title: `Through ${t.name}`, group: bookGroup(t.slug), note: `${count(list.length)} in passage order · ${years(list)}`, sermons: inPassageOrder(list) }];
}
const group = t.kind === "book" ? bookGroup(t.slug) : t.kind === "series" ? seriesInfo(t).group : undefined;

// The meta description, where the live site had none: what the page holds, then why it is worth opening.
const where = "at Saving Grace Bible Church, Melbourne";
const metaDescription = t.seo.description || {
  speaker: `${count(list.length)} preached by ${t.name} ${where}. Watch or listen online and read the descriptions and transcripts.`,
  series: `${count(list.length)} in the ${t.name} series ${where}. Watch or listen online and read the descriptions and transcripts.`,
  book: `${count(list.length)} preached from ${t.name} ${where}, in passage order. Watch or listen online and read the transcripts.`,
  passage: `${count(list.length)} on ${t.name} ${where}. Watch or listen online and read the description and transcript.`,
}[t.kind];

// A series that shares its name with a Bible book or a sermon ("Luke", "The Heart of Pride") had the same
// title tag as that page. Its title now says it is the series; custom titles are left alone.
const SUFFIX = " - Saving Grace Bible Church - Bible-Based Worship in Melbourne";
const clashes = t.kind === "series" && (term("book", t.slug) !== undefined || sermons.some((s) => s.title === t.name));
const title = clashes && t.seo.title === `${t.name}${SUFFIX}` ? `${t.name} Sermon Series${SUFFIX}` : t.seo.title;

// Who the speaker is, for search engines and AI answers. Roles are those given on the Elders page.
const roles: Record<string, { jobTitle: string; image: string }> = {
  "wesam-saad": { jobTitle: "Pastor", image: "wesam" },
  "ralph-gambardella": { jobTitle: "Elder", image: "ralph" },
};
const role = t.kind === "speaker" ? roles[t.slug] : undefined;
const portrait = role ? imageFor(role.image) : undefined;
const jsonLd: Record<string, unknown>[] = [{ "@context": "https://schema.org", "@type": "CollectionPage", url: `${SITE}${t.path}`, name: t.name, description: metaDescription, inLanguage: "en-AU", isPartOf: { "@id": `${SITE}/#website` } }];
if (t.kind === "speaker") {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${SITE}${t.path}#person`,
    name: t.name,
    url: `${SITE}${t.path}`,
    ...(role ? { jobTitle: role.jobTitle, affiliation: { "@type": "Church", "@id": `${SITE}/#church`, name: SITE_NAME, url: `${SITE}/` } } : {}),
    ...(portrait ? { image: `${SITE}${portrait.src}` } : {}),
  });
}
---
<BaseLayout
  search={{ type: null }}
  title={title}
  description={metaDescription}
  canonical={t.path}
  indexable={list.length > 0}
  breadcrumbs={[{ name: "Home", path: "/" }, { name: "Sermons", path: "/sermons/" }, { name: label.plural, path: label.path }, { name: t.name, path: t.path }]}
  jsonLd={jsonLd}
>
  <article class:list={["page", "page--listing", group && `hue--${group}`]} data-pagefind-ignore="all">
    <PageHead
      title={t.name}
      trail={[{ label: "Home", href: "/" }, { label: "Sermons", href: "/sermons/" }, { label: label.plural, href: label.path }]}
      eyebrow={label.singular}
      lede={intro}
      hero={t.name === "Wesam Saad" ? { media: "wesam" } : t.name === "Ralph Gambardella" ? { media: "ralph" } : null}
    />
    <div class="wrap listing">
      {sections.length > 1 && (
        <nav class="listing__jump" aria-label="Jump to a section">
          <ul class="browse__chips" role="list">{sections.map((s) => <li><a class="chip" href={`#${s.id}`}>{s.title}<span class="chip__count">{s.sermons.length}</span></a></li>)}</ul>
        </nav>
      )}
      {sections.map((s) => (
        <section class={`listing__section hue--${s.group}`} id={s.id}>
          <header class="listing__head">
            <div class="listing__title"><span class="listing__tab" aria-hidden="true"></span><h2>{s.title}</h2></div>
            <p class="listing__count">{s.note}{s.more && <> · <a href={s.more.href}>{s.more.label}</a></>}</p>
          </header>
          <JournalList sermons={s.sermons} limit={sections.length > 1 ? 5 : 12} />
        </section>
      ))}
      {t.kind === "passage" && <JournalList sermons={list} headingLevel={2} />}
    </div>
  </article>
</BaseLayout>
