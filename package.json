{
  "name": "saving-grace-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && pagefind --site dist && node scripts/nginx-redirects.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "import:wordpress": "node scripts/import-wordpress.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "validate": "node scripts/validate-data.mjs",
    "admin:dev": "astro dev --root admin --host 127.0.0.1 --port 4330",
    "admin:build": "astro build --root admin"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "pagefind": "1.6.0",
    "typescript": "6.0.3"
  }
}
